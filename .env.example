# Copy this file to .env and fill in your key. .env is git-ignored.
# Needed only by the web host and the evaluation, not by the MCP server itself.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: which Groq model the host uses (default: openai/gpt-oss-120b)
# NORTHWIND_MODEL=openai/gpt-oss-120b
